NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mqi?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
TEST_ALLOWED_HOSTS=your-authorized-test-domain.com
PLAYWRIGHT_HEADLESS=true
# Gemini-powered QA scenario generation (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional screenshot evidence storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_EVIDENCE_FOLDER=mawutech-qa-intelligence/evidence
